# Backend configuration for FastAPI server

# REQUIRED: Secret key used for signing JWT tokens
SECRET_KEY=change_me_to_a_long_random_string

# SQLite connection string (default used if not provided)
# Examples:
#   sqlite:///./data.sqlite           (relative file)
#   sqlite:////absolute/path/data.db  (absolute file)
#   postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data.sqlite

# Token expiration in minutes (default 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: comma-separated CORS origins; use "*" to allow all (default "*")
# e.g. http://localhost:3000,https://myapp.com
CORS_ORIGINS=*

# Optional: Server port for uvicorn (not read by code directly; used by your runner)
# PORT=4003
