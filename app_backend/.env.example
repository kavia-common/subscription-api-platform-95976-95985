# Backend configuration
# Copy this file to .env and adjust values as needed

# Port for the backend server
PORT=4003

# JWT secret for signing tokens (set a strong random value in production)
JWT_SECRET=change_me_to_a_long_random_string

# SQLite database storage path (relative to app_backend/)
DB_SQLITE_PATH=./data.sqlite

# Optional: Allowed CORS origin (set to your frontend URL, e.g., http://localhost:3000)
CORS_ORIGIN=http://localhost:3000
